---
/**
@file index.astro
@component

Index.astro serves as the main layout for the site's homepage.
@returns {HTML} The complete, rendered homepage HTML
*/

import Base from "@/layouts/components/common/Base.astro";
import CircularCarousel from '@/layouts/scripts/CircularCarousel.tsx';

import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const homepage = (await getEntry(
  "buttonPage",
  "-index"
)) as CollectionEntry<"buttonPage">;
const { banner, table_with_links, cta } = homepage.data;

const items = [
  { src: '/AIBlog/images/post-1.png', alt: 'Mist drifting through a valley', title: 'Valley', subtitle: 'Landscape' },
  { src: '/AIBlog/images/post-2.png', alt: 'A studio portrait', title: 'Portrait', subtitle: 'Studio' },
  { src: '/AIBlog/images/post-3.png', alt: 'Glass towers from street level', title: 'Towers', subtitle: 'Architecture' },
  { src: '/AIBlog/images/post-4.png', alt: 'Mist drifting through a valley', title: 'Valley', subtitle: 'Landscape' },
  { src: '/AIBlog/images/post-5.png', alt: 'A studio portrait', title: 'Portrait', subtitle: 'Studio' },
  { src: '/AIBlog/images/post-6.png', alt: 'Glass towers from street level', title: 'Towers', subtitle: 'Architecture' },
    { src: '/AIBlog/images/mov1.mp4', alt: 'Glass towers from street level', title: 'Towers', subtitle: 'Architecture' }
];
---

<Base>
 <section class="section">
    <div class="container">
        <div style={{ width: '100%', height: '560px', position: 'relative' }}>
  <CircularCarousel
  client:load
    items={items}
    preset="cylinder"
    intro="rise"
    cardWidth={1200}
    aspectRatio={1.4}
    speed={14}
    captions={false}
    gap={25}
    tilt={-5}
    curve={0.3}
    perspective={2500}
    autoplay="drift"
    interval={3}
    direction="left"
    momentum={0.6}
    snap
    pauseOnHover
    focusOnClick
    draggable
    parallax={0.3}
    stretch={0.5}
    fadeColor="#000000"
    depthFade={0.11}
    innerShade={0.6}
    cornerRadius={12}
/>
</div>
    </div>
  </section>
</Base>

