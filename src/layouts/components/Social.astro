---
import * as Icon from "react-feather";
import { humanize } from "@/lib/utils/textConverter";

interface Props {
  source?: Record<string, string>;
  className?: string;
}

const { source = {}, className = "" } = Astro.props;

type SocialItem = {
  platform: string;
  url: string;
  IconComponent: any;
};

function sanitizeUrl(rawUrl: string, key: string): string | undefined {
  let str = rawUrl.trim();

  if (key === "email" && !str.startsWith("mailto:")) {
    return `mailto:${str}`;
  }
  if (key === "phone" && !str.startsWith("tel:")) {
    return `tel:${str}`;
  }
  if (str.startsWith("mailto:") || str.startsWith("tel:")) {
    return str;
  }

  if (!/^https?:\/\//i.test(str)) {
    str = `https://${str}`;
  }

  try {
    const parsed = new URL(str);
    return parsed.href;
  } catch {
    return undefined;
  }
}

const socialList: SocialItem[] = Object.entries(source)
  .map(([platform, rawUrl]) => {
    if (typeof rawUrl !== "string" || !rawUrl.trim()) return null;

    const key = platform.toLowerCase();
    const validUrl = sanitizeUrl(rawUrl, key);

    if (!validUrl) return null;

    // Matches the pattern from CardTable4xN.jsx with a fallback default icon
    const humanized = humanize(platform || "globe");
    const featherIconKey = (humanized || "Globe").replace(/\s+/g, "");
    const DynamicFeatherIcon =
      (Icon as Record<string, any>)[featherIconKey] || Icon.Globe;

    return {
      platform,
      url: validUrl,
      IconComponent: DynamicFeatherIcon,
    };
  })
  .filter((item): item is SocialItem => item !== null);
---

<ul class={className}>
  {
    socialList.map(({ platform, url, IconComponent }) => {
      const isInternal = url.startsWith("mailto:") || url.startsWith("tel:");
      return (
        <li class="inline-block mr-3 last:mr-0">
          <a
            aria-label={platform}
            href={url}
            target={isInternal ? null : "_blank"}
            rel={isInternal ? null : "noopener noreferrer nofollow"}
            class="hover:text-primary transition-colors"
          >
            <IconComponent />
          </a>
        </li>
      );
    })
  }
</ul>
