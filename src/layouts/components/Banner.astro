---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import LiquidEther from  "../scripts/LiquidEther";
const { banner } = Astro.props;
const { title, image, content } = banner;

// 1. Glob all images in src/images/
const images = import.meta.glob<{ default: ImageMetadata }>('/src/images/**/*.{jpeg,jpg,png,gif,svg,webp}');

// 2. Resolve the matching image function (handles missing paths gracefully)
const imagePath = image?.startsWith('/') ? image : `/${image}`;
if (!images[imagePath]) {
  throw new Error(`"${imagePath}" does not exist in glob: "/src/images/**/*.{jpeg,jpg,png,gif,svg,webp}"`);
}

---

<section class="section banner relative overflow-hidden">
<LiquidEther
    client:only="react"
  />
  <div class="container relative z-10">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title" set:html={markdownify(title)} />

        <p class="mt-6" set:html={markdownify(content)} />
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src={images[imagePath]()}
          width={603}
          height={396}
        />
      </div>
  </div>
  </div>
</section>
