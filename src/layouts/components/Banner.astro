---
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import LiquidEther from  "/src/layouts/scripts/LiquidEther.jsx";
const { banner } = Astro.props;
const { title, image, content } = banner;

---

<section class="section banner relative overflow-hidden">
<LiquidEther
    client:only="react"
  />
  <div class="container relative z-10">
    <div class="row items-center">
      <div class="lg:col-6">
        <h1 class="banner-title" set:html={markdownify(title)} />

        <p class="mt-6" set:html={markdownify(content)} />
      </div>
      <div class="lg:col-6">
        <Image
          class="w-full object-contain"
          alt="banner"
          src={image}
          width={603}
          height={396}
        />
      </div>
  </div>
  </div>
</section>
