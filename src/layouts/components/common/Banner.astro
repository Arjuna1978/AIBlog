---
import { markdownify } from "@/lib/utils/textConverter";
import { resolveImage } from "@/lib/utils/resolveImage";
import { Image } from "astro:assets";
import LiquidEther from "../../scripts/LiquidEther";

const { banner } = Astro.props;
const { title, image, content } = banner;

const imageMetadata = await resolveImage(image);
---

<section class="section banner relative overflow-hidden">
  <LiquidEther client:only="react" />
  <div class="container relative z-10">
    <div class="row items-center">
      <div class="lg:col-6">
        {title && <h1 class="banner-title" set:html={markdownify(title)} />}
        {content && <p class="mt-6" set:html={markdownify(content)} />}
      </div>
      <div class="lg:col-6">
        {
          imageMetadata ? (
            <Image
              class="w-full object-contain"
              alt={title || "banner"}
              src={imageMetadata}
              width={603}
              height={396}
            />
          ) : (
            image && <p class="text-red-400 text-sm italic">Image not found: {image}</p>
          )
        }
      </div>
    </div>
  </div>
</section>
